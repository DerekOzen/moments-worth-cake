    {
      "id": "b-1",
      "type": "section",
      "props": {
        "label": "Main",
        "role": "section",
        "html": "<main id=\"main\">\n\n<!-- ================= HERO ================= -->\n<section class=\"hero\">\n  <div class=\"wrap\">\n    <div class=\"hero-grid\">\n      <div>\n        <hr class=\"rule\">\n        <span class=\"eyebrow\">Sweet Creations for Moments Worth Celebrating.</span>\n        <h1>Custom cakes for Australia's <em>biggest moments</em></h1>\n        <p class=\"lead\">Discover cake makers, cake designers and dessert artists near you, then share one cake brief and let the right people respond. There is no obligation to book.</p>\n        <div class=\"hero-actions\">\n          <a class=\"btn btn-1\" href=\"/get-cake-maker-quotes/\">Plan your cake<svg width=\"15\" height=\"12\" viewBox=\"0 0 15 12\" fill=\"none\" aria-hidden=\"true\"><path d=\"M9 1l5 5-5 5M14 6H1\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></a>\n          <a class=\"btn btn-2\" href=\"/occasions/\">Browse by celebration</a>\n        </div>\n        <ul class=\"trust\">\n          <li><svg width=\"11\" height=\"11\" viewBox=\"0 0 12 12\" aria-hidden=\"true\"><path d=\"M6 0c.5 2.6 1.4 3.5 4 4-2.6.5-3.5 1.4-4 4-.5-2.6-1.4-3.5-4-4 2.6-.5 3.5-1.4 4-4z\" fill=\"currentColor\"></path></svg>Australia wide</li>\n          <li><svg width=\"11\" height=\"11\" viewBox=\"0 0 12 12\" aria-hidden=\"true\"><path d=\"M6 0c.5 2.6 1.4 3.5 4 4-2.6.5-3.5 1.4-4 4-.5-2.6-1.4-3.5-4-4 2.6-.5 3.5-1.4 4-4z\" fill=\"currentColor\"></path></svg>One brief, several responses</li>\n          <li><svg width=\"11\" height=\"11\" viewBox=\"0 0 12 12\" aria-hidden=\"true\"><path d=\"M6 0c.5 2.6 1.4 3.5 4 4-2.6.5-3.5 1.4-4 4-.5-2.6-1.4-3.5-4-4 2.6-.5 3.5-1.4 4-4z\" fill=\"currentColor\"></path></svg>No obligation to book</li>\n        </ul>\n      </div>\n\n      <div class=\"hero-art\">\n        <div class=\"fig arch f-main\">\n          <img src=\"https://images.unsplash.com/photo-1565661834013-d196ca46e14e?auto=format&amp;fit=crop&amp;q=80&amp;w=900\" alt=\"A contemporary three-tier celebration cake finished with fresh figs and soft buttercream.\" fetchpriority=\"high\" width=\"900\" height=\"1200\">\n        </div>\n        <div class=\"fig f-det f-a\">\n          <img src=\"https://images.unsplash.com/photo-1581016327131-6cf17ab1f2c1?auto=format&amp;fit=crop&amp;q=80&amp;w=560\" alt=\"Close-up of piped buttercream swirls, soft and freshly worked.\" loading=\"lazy\" width=\"560\" height=\"560\">\n        </div>\n        <div class=\"fig f-det f-b\">\n          <img src=\"https://images.unsplash.com/photo-1649773289945-93a96051fd18?auto=format&amp;fit=crop&amp;q=80&amp;w=520\" alt=\"A cake decorator piping detail onto a cake by hand.\" loading=\"lazy\" width=\"520\" height=\"650\">\n        </div>\n        <svg class=\"piped\" viewBox=\"0 0 160 26\" fill=\"none\" aria-hidden=\"true\"><path d=\"M2 22q11-18 22 0 11-18 22 0 11-18 22 0 11-18 22 0 11-18 22 0 11-18 22 0 11-18 22 0\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg>\n      </div>\n    </div>\n  </div>\n</section>\n<!-- ================= BROWSE BY CELEBRATION ================= -->\n<section>\n  <div class=\"wrap\">\n    <div class=\"sec-head\">\n      <hr class=\"rule\">\n      <span class=\"eyebrow\">Life is full of moments worth cake</span>\n      <h2>Browse by <em>celebration</em></h2>\n      <p class=\"lead\">Start with the moment instead of the ingredient list. Each celebration leads to the cakes, styles and creators that suit it.</p>\n    </div>\n\n    <div class=\"gal\">\n      <a href=\"/kids-birthday-cakes/\">\n        <div class=\"fig\"><img src=\"https://images.unsplash.com/photo-1728832152347-79d3c9bab43e?auto=format&amp;fit=crop&amp;q=80&amp;w=640\" alt=\"A small first birthday cake with a single lit candle.\" loading=\"lazy\" width=\"640\" height=\"800\"></div>\n        <span class=\"num\" aria-hidden=\"true\">01</span>\n        <h3>First Birthdays</h3>\n        <p>One candle, and a whole year worth remembering.</p>\n        <span class=\"go\">Explore<svg width=\"13\" height=\"10\" viewBox=\"0 0 15 12\" fill=\"none\" aria-hidden=\"true\"><path d=\"M9 1l5 5-5 5M14 6H1\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span>\n      </a>\n\n      <a href=\"/kids-birthday-cakes/\">\n        <div class=\"fig\"><img src=\"https://images.unsplash.com/photo-1553710120-23dd1551da41?auto=format&amp;fit=crop&amp;q=80&amp;w=640\" alt=\"A colourful rainbow themed children's birthday cake with candles.\" loading=\"lazy\" width=\"640\" height=\"640\"></div>\n        <span class=\"num\" aria-hidden=\"true\">02</span>\n        <h3>Kids Birthdays</h3>\n        <p>Colour, character and pure delight.</p>\n        <span class=\"go\">Explore<svg width=\"13\" height=\"10\" viewBox=\"0 0 15 12\" fill=\"none\" aria-hidden=\"true\"><path d=\"M9 1l5 5-5 5M14 6H1\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span>\n      </a>\n\n      <a href=\"/birthday-cakes/\">\n        <div class=\"fig\"><img src=\"https://images.unsplash.com/photo-1602351447937-745cb720612f?auto=format&amp;fit=crop&amp;q=80&amp;w=640\" alt=\"A layered chocolate cake with ganache drips and fine sugar pearls.\" loading=\"lazy\" width=\"640\" height=\"853\"></div>\n        <span class=\"num\" aria-hidden=\"true\">03</span>\n        <h3>Milestone Birthdays</h3>\n        <p>Eighteen, thirty, fifty and every year between.</p>\n        <span class=\"go\">Explore<svg width=\"13\" height=\"10\" viewBox=\"0 0 15 12\" fill=\"none\" aria-hidden=\"true\"><path d=\"M9 1l5 5-5 5M14 6H1\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span>\n      </a>\n\n      <a href=\"/engagement-cakes/\">\n        <div class=\"fig\"><img src=\"https://images.unsplash.com/photo-1559373098-e1caaccae791?auto=format&amp;fit=crop&amp;q=80&amp;w=640\" alt=\"A tiered cake dressed with fresh pink flowers beside two champagne glasses.\" loading=\"lazy\" width=\"640\" height=\"800\"></div>\n        <span class=\"num\" aria-hidden=\"true\">04</span>\n        <h3>Engagements</h3>\n        <p>A sweet way to mark the yes.</p>\n        <span class=\"go\">Explore<svg width=\"13\" height=\"10\" viewBox=\"0 0 15 12\" fill=\"none\" aria-hidden=\"true\"><path d=\"M9 1l5 5-5 5M14 6H1\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span>\n      </a>\n\n      <a href=\"/wedding-cakes/\">\n        <div class=\"fig\"><img src=\"https://images.unsplash.com/photo-1623428454614-abaf00244e52?auto=format&amp;fit=crop&amp;q=80&amp;w=640\" alt=\"A white wedding cake finished with fresh strawberries and flowers.\" loading=\"lazy\" width=\"640\" height=\"640\"></div>\n        <span class=\"num\" aria-hidden=\"true\">05</span>\n        <h3>Weddings</h3>\n        <p>The cake everybody gathers around.</p>\n        <span class=\"go\">Explore<svg width=\"13\" height=\"10\" viewBox=\"0 0 15 12\" fill=\"none\" aria-hidden=\"true\"><path d=\"M9 1l5 5-5 5M14 6H1\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span>\n      </a>\n\n      <a href=\"/baby-shower-cakes/\">\n        <div class=\"fig\"><img src=\"https://images.unsplash.com/photo-1673417284575-cb29c8631125?auto=format&amp;fit=crop&amp;q=80&amp;w=640\" alt=\"A soft pink and white baby shower cake styled with balloons.\" loading=\"lazy\" width=\"640\" height=\"853\"></div>\n        <span class=\"num\" aria-hidden=\"true\">06</span>\n        <h3>Baby Showers</h3>\n        <p>New beginnings worth celebrating.</p>\n        <span class=\"go\">Explore<svg width=\"13\" height=\"10\" viewBox=\"0 0 15 12\" fill=\"none\" aria-hidden=\"true\"><path d=\"M9 1l5 5-5 5M14 6H1\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span>\n      </a>\n\n      <a href=\"/anniversary-cakes/\">\n        <div class=\"fig\"><img src=\"https://images.unsplash.com/photo-1606890737304-57a1ca8a5b62?auto=format&amp;fit=crop&amp;q=80&amp;w=640\" alt=\"A rich layered chocolate cake with dark cherries and a glossy red glaze.\" loading=\"lazy\" width=\"640\" height=\"800\"></div>\n        <span class=\"num\" aria-hidden=\"true\">07</span>\n        <h3>Anniversaries</h3>\n        <p>For the years, and the moments between them.</p>\n        <span class=\"go\">Explore<svg width=\"13\" height=\"10\" viewBox=\"0 0 15 12\" fill=\"none\" aria-hidden=\"true\"><path d=\"M9 1l5 5-5 5M14 6H1\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span>\n      </a>\n\n      <a href=\"/corporate-cakes/\">\n        <div class=\"fig\"><img src=\"https://images.unsplash.com/photo-1702323213598-2b715d326919?auto=format&amp;fit=crop&amp;q=80&amp;w=640\" alt=\"Three small modern cakes presented on white pedestals.\" loading=\"lazy\" width=\"640\" height=\"640\"></div>\n        <span class=\"num\" aria-hidden=\"true\">08</span>\n        <h3>Corporate</h3>\n        <p>Launches, achievements and team moments.</p>\n        <span class=\"go\">Explore<svg width=\"13\" height=\"10\" viewBox=\"0 0 15 12\" fill=\"none\" aria-hidden=\"true\"><path d=\"M9 1l5 5-5 5M14 6H1\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span>\n      </a>\n    </div>\n\n    <p style=\"margin-top:56px\"><a class=\"btn btn-2\" href=\"/occasions/\">See every occasion</a></p>\n  </div>\n</section>\n\n<!-- ================= CAKES & DESSERTS ================= -->\n<section class=\"band-straw\">\n  <div class=\"wrap\">\n    <div class=\"feature\">\n      <div class=\"feature-art hov\">\n        <div class=\"fig f-lead\"><img src=\"https://images.unsplash.com/photo-1495147466023-ac5c588e2e94?auto=format&amp;fit=crop&amp;q=80&amp;w=900\" alt=\"A styled spread of miniature tarts finished with cream and edible flowers.\" loading=\"lazy\" width=\"900\" height=\"1035\"></div>\n        <div class=\"fig f-inset\"><img src=\"https://images.unsplash.com/photo-1508349307373-ab2edc239589?auto=format&amp;fit=crop&amp;q=80&amp;w=520\" alt=\"Assorted pastries arranged on a glass stand.\" loading=\"lazy\" width=\"520\" height=\"520\"></div>\n      </div>\n\n      <div>\n        <div class=\"sec-head\" style=\"margin-bottom:36px\">\n          <hr class=\"rule\">\n          <span class=\"eyebrow\">What do you need made</span>\n          <h2>Cakes, and everything <em>served beside them</em></h2>\n          <p class=\"lead\">Custom cakes are quoted, not bought off a shelf. Tell a maker the celebration, the number of guests and the look you are drawn to, and the design follows from there.</p>\n        </div>\n\n        <ul class=\"menu-list\">\n          <li><a href=\"/custom-cakes/\"><h3>Custom Cakes</h3><p>Designed around your celebration, not a catalogue.</p><span class=\"go\"><span>Explore</span><svg width=\"14\" height=\"11\" viewBox=\"0 0 15 12\" fill=\"none\" aria-hidden=\"true\"><path d=\"M9 1l5 5-5 5M14 6H1\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span></a></li>\n          <li><a href=\"/wedding-cakes/\"><h3>Wedding Cakes</h3><p>Tiers, textures, florals and the final slice.</p><span class=\"go\"><span>Explore</span><svg width=\"14\" height=\"11\" viewBox=\"0 0 15 12\" fill=\"none\" aria-hidden=\"true\"><path d=\"M9 1l5 5-5 5M14 6H1\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span></a></li>\n          <li><a href=\"/birthday-cakes/\"><h3>Birthday Cakes</h3><p>Milestone numbers and modern celebration designs.</p><span class=\"go\"><span>Explore</span><svg width=\"14\" height=\"11\" viewBox=\"0 0 15 12\" fill=\"none\" aria-hidden=\"true\"><path d=\"M9 1l5 5-5 5M14 6H1\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span></a></li>\n          <li><a href=\"/kids-birthday-cakes/\"><h3>Kids Birthday Cakes</h3><p>Themes, characters and colour done properly.</p><span class=\"go\"><span>Explore</span><svg width=\"14\" height=\"11\" viewBox=\"0 0 15 12\" fill=\"none\" aria-hidden=\"true\"><path d=\"M9 1l5 5-5 5M14 6H1\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span></a></li>\n          <li><a href=\"/celebration-cakes/\"><h3>Celebration Cakes</h3><p>Graduations, retirements and every congratulations.</p><span class=\"go\"><span>Explore</span><svg width=\"14\" height=\"11\" viewBox=\"0 0 15 12\" fill=\"none\" aria-hidden=\"true\"><path d=\"M9 1l5 5-5 5M14 6H1\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span></a></li>\n          <li><a href=\"/dessert-tables/\"><h3>Dessert Tables</h3><p>Cake, plus everything served beside it.</p><span class=\"go\"><span>Explore</span><svg width=\"14\" height=\"11\" viewBox=\"0 0 15 12\" fill=\"none\" aria-hidden=\"true\"><path d=\"M9 1l5 5-5 5M14 6H1\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span></a></li>\n        </ul>\n\n        <p style=\"margin-top:34px\"><a class=\"btn btn-2\" href=\"/cakes-desserts/\">All cakes and desserts</a></p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ================= SPECIALISTS ================= -->\n<section>\n  <div class=\"wrap\">\n    <div class=\"sec-head center\">\n      <hr class=\"rule center\">\n      <span class=\"eyebrow\">Find a specialist</span>\n      <h2>Not every cake needs <em>the same kind of maker</em></h2>\n      <p class=\"lead\">A cake decorator, a design-led cake designer and a dessert artist solve different problems. Some describe themselves as a cake artist, others simply as a custom cake maker. Knowing which one you need makes the brief easier to write and the quotes easier to compare.</p>\n    </div>\n\n    <div class=\"pgrid\">\n      <div class=\"pcard hov\">\n        <div class=\"fig\"><img src=\"https://images.unsplash.com/photo-1578985545062-69928b1d9587?auto=format&amp;fit=crop&amp;q=80&amp;w=560\" alt=\"A chocolate layer cake finished with piped rosettes and a ganache drip.\" loading=\"lazy\" width=\"560\" height=\"746\"></div>\n        <span class=\"num\" aria-hidden=\"true\">01</span>\n        <h3>Cake Makers</h3>\n        <div class=\"bar\"></div>\n        <p>The people who bake, build and finish the cake itself.</p>\n      </div>\n      <div class=\"pcard hov\">\n        <div class=\"fig\"><img src=\"https://images.unsplash.com/photo-1759769583882-556d39191357?auto=format&amp;fit=crop&amp;q=80&amp;w=560\" alt=\"A design-led green cake with rippled frosting and gold pearls.\" loading=\"lazy\" width=\"560\" height=\"746\"></div>\n        <span class=\"num\" aria-hidden=\"true\">02</span>\n        <h3>Cake Designers</h3>\n        <div class=\"bar\"></div>\n        <p>Design-led creators who shape the look before the bake.</p>\n      </div>\n      <div class=\"pcard hov\">\n        <div class=\"fig\"><img src=\"https://images.unsplash.com/photo-1535254973040-607b474cb50d?auto=format&amp;fit=crop&amp;q=80&amp;w=560\" alt=\"A tall tiered wedding cake with garden roses cascading down one side.\" loading=\"lazy\" width=\"560\" height=\"746\"></div>\n        <span class=\"num\" aria-hidden=\"true\">03</span>\n        <h3>Wedding Cake Makers</h3>\n        <div class=\"bar\"></div>\n        <p>Specialists in tiered cakes, tastings and venue delivery.</p>\n      </div>\n      <div class=\"pcard hov\">\n        <div class=\"fig\"><img src=\"https://images.unsplash.com/photo-1675949873154-7496809f1c9b?auto=format&amp;fit=crop&amp;q=80&amp;w=560\" alt=\"A styled spread of desserts arranged for an event.\" loading=\"lazy\" width=\"560\" height=\"746\"></div>\n        <span class=\"num\" aria-hidden=\"true\">04</span>\n        <h3>Dessert Artists</h3>\n        <div class=\"bar\"></div>\n        <p>Grazing and dessert styling that works alongside a cake.</p>\n      </div>\n    </div>\n\n    <p style=\"margin-top:56px;text-align:center\"><a class=\"btn btn-1\" href=\"/find-a-cake-maker/\">Find a cake maker<svg width=\"15\" height=\"12\" viewBox=\"0 0 15 12\" fill=\"none\" aria-hidden=\"true\"><path d=\"M9 1l5 5-5 5M14 6H1\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></a></p>\n  </div>\n</section>\n<!-- ================= A CAKE IS NEVER JUST DESSERT ================= -->\n<section>\n  <div class=\"wrap\">\n    <div class=\"story\">\n      <div>\n        <div class=\"sec-head\" style=\"margin-bottom:32px\">\n          <hr class=\"rule\">\n          <span class=\"eyebrow\">Why the cake matters</span>\n          <h2>A cake is never <em>just dessert</em></h2>\n          <p class=\"lead\">It is the candle photo. The first slice. The table everybody gathers around when the room finally goes quiet. Moments Worth Cake exists to help you find the person who can make that part of the day feel considered.</p>\n        </div>\n        <p class=\"quiet\">The idea grew out of more than 15 years spent across celebrations, events, styling, customer service and working alongside event suppliers. That experience shaped how this platform is built, and what it asks you before it asks anyone else.</p>\n        <p style=\"margin-bottom:0;margin-top:30px\"><a class=\"btn btn-2\" href=\"/about/\">Our story</a></p>\n      </div>\n\n      <div class=\"story-art hov\">\n        <div class=\"fig f-lead\"><img src=\"https://images.unsplash.com/photo-1545696563-af8f6ec2295a?auto=format&amp;fit=crop&amp;q=80&amp;w=880\" alt=\"A hand lighting the candles on a berry-topped celebration cake.\" loading=\"lazy\" width=\"880\" height=\"1020\"></div>\n        <div class=\"fig f-sub\"><img src=\"https://images.unsplash.com/photo-1621303837174-89787a7d4729?auto=format&amp;fit=crop&amp;q=80&amp;w=560\" alt=\"A sprinkle covered party cake with a slice cut and ready to serve.\" loading=\"lazy\" width=\"560\" height=\"448\"></div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ================= GUIDANCE ================= -->\n<section>\n  <div class=\"wrap\">\n    <div class=\"sec-head\">\n      <hr class=\"rule\">\n      <span class=\"eyebrow\">Planning something special</span>\n      <h2>A little guidance <em>before the cake</em></h2>\n      <p class=\"lead\">Most cake decisions come down to four questions. These guides answer them before you speak to anybody.</p>\n    </div>\n\n    <div class=\"guides\">\n      <a class=\"guide-lead\" href=\"/cake-ideas/cake-size-serving-guide/\">\n        <div class=\"fig\"><img src=\"https://images.unsplash.com/photo-1635888070574-beb32aa9b06d?auto=format&amp;fit=crop&amp;q=80&amp;w=900\" alt=\"A cut slice of layered cake plated and ready to serve.\" loading=\"lazy\" width=\"900\" height=\"619\"></div>\n        <h3>How much cake do you need?</h3>\n        <p>Serving numbers, tin sizes and the maths behind them.</p>\n        <span class=\"go\">Read the guide<svg width=\"13\" height=\"10\" viewBox=\"0 0 15 12\" fill=\"none\" aria-hidden=\"true\"><path d=\"M9 1l5 5-5 5M14 6H1\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span>\n      </a>\n\n      <ul class=\"guide-rows\">\n        <li><a href=\"/cake-ideas/booking-timeline/\">\n          <div class=\"fig\"><img src=\"https://images.unsplash.com/photo-1525257831700-183b9b8bf5c4?auto=format&amp;fit=crop&amp;q=80&amp;w=260\" alt=\"A four-tier white floral wedding cake.\" loading=\"lazy\" width=\"260\" height=\"260\"></div>\n          <div><h3>When should you book?</h3><p>Lead times for weddings, birthdays and short-notice cakes.</p><span class=\"go\">Read the guide<svg width=\"13\" height=\"10\" viewBox=\"0 0 15 12\" fill=\"none\" aria-hidden=\"true\"><path d=\"M9 1l5 5-5 5M14 6H1\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span></div>\n        </a></li>\n        <li><a href=\"/cake-ideas/\">\n          <div class=\"fig\"><img src=\"https://images.unsplash.com/photo-1604702433171-33756f3f3825?auto=format&amp;fit=crop&amp;q=80&amp;w=260\" alt=\"A floral-decorated cake on a wooden stand.\" loading=\"lazy\" width=\"260\" height=\"260\"></div>\n          <div><h3>What shapes the price?</h3><p>Tiers, technique, florals, delivery and setup.</p><span class=\"go\">Read the guide<svg width=\"13\" height=\"10\" viewBox=\"0 0 15 12\" fill=\"none\" aria-hidden=\"true\"><path d=\"M9 1l5 5-5 5M14 6H1\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span></div>\n        </a></li>\n        <li><a href=\"/cake-ideas/\">\n          <div class=\"fig\"><img src=\"https://images.unsplash.com/photo-1697320846048-43f9631634c6?auto=format&amp;fit=crop&amp;q=80&amp;w=260\" alt=\"A minimal white cake finished with orange flowers.\" loading=\"lazy\" width=\"260\" height=\"260\"></div>\n          <div><h3>What style suits the moment?</h3><p>Language for describing the look you want.</p><span class=\"go\">Read the guide<svg width=\"13\" height=\"10\" viewBox=\"0 0 15 12\" fill=\"none\" aria-hidden=\"true\"><path d=\"M9 1l5 5-5 5M14 6H1\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span></div>\n        </a></li>\n      </ul>\n    </div>\n  </div>\n</section>\n\n<!-- ================= LOCATIONS ================= -->\n<section class=\"band-cream2\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\">\n      <hr class=\"rule\">\n      <span class=\"eyebrow\">Find cake makers near you</span>\n      <h2>Cake makers <em>across Australia</em></h2>\n      <p class=\"lead\">Cake making is local by nature, because someone has to deliver it, set it up and keep it upright. Start with your state, then narrow to your market.</p>\n    </div>\n\n    <div class=\"states\">\n      <a href=\"/locations/nsw/\"><h3>New South Wales</h3><p>Sydney, Newcastle and the Central Coast</p><span class=\"go\">See markets<svg width=\"13\" height=\"10\" viewBox=\"0 0 15 12\" fill=\"none\" aria-hidden=\"true\"><path d=\"M9 1l5 5-5 5M14 6H1\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span></a>\n      <a href=\"/locations/vic/\"><h3>Victoria</h3><p>Melbourne, Geelong, the Peninsula and the growth corridors</p><span class=\"go\">See markets<svg width=\"13\" height=\"10\" viewBox=\"0 0 15 12\" fill=\"none\" aria-hidden=\"true\"><path d=\"M9 1l5 5-5 5M14 6H1\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span></a>\n      <a href=\"/locations/qld/\"><h3>Queensland</h3><p>Gold Coast, Sunshine Coast, Ipswich and Toowoomba</p><span class=\"go\">See markets<svg width=\"13\" height=\"10\" viewBox=\"0 0 15 12\" fill=\"none\" aria-hidden=\"true\"><path d=\"M9 1l5 5-5 5M14 6H1\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span></a>\n      <a href=\"/locations/wa/\"><h3>Western Australia</h3><p>Perth and the surrounding metropolitan markets</p><span class=\"go\">See markets<svg width=\"13\" height=\"10\" viewBox=\"0 0 15 12\" fill=\"none\" aria-hidden=\"true\"><path d=\"M9 1l5 5-5 5M14 6H1\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span></a>\n    </div>\n\n    <div class=\"markets\">\n      <h3>Popular markets</h3>\n      <ul class=\"linklist\">\n        <li><a href=\"/locations/nsw/cake-makers-sydney/\">Cake Makers Sydney</a></li>\n        <li><a href=\"/locations/vic/cake-makers-melbourne/\">Cake Makers Melbourne</a></li>\n        <li><a href=\"/locations/qld/cake-makers-gold-coast/\">Cake Makers Gold Coast</a></li>\n        <li><a href=\"/locations/wa/cake-makers-perth/\">Cake Makers Perth</a></li>\n        <li><a href=\"/locations/qld/cake-makers-sunshine-coast/\">Cake Makers Sunshine Coast</a></li>\n        <li><a href=\"/locations/nsw/cake-makers-newcastle/\">Cake Makers Newcastle</a></li>\n        <li><a href=\"/locations/vic/cake-makers-geelong/\">Cake Makers Geelong</a></li>\n        <li><a href=\"/locations/nsw/cake-makers-central-coast/\">Cake Makers Central Coast</a></li>\n        <li><a href=\"/locations/qld/cake-makers-toowoomba/\">Cake Makers Toowoomba</a></li>\n        <li><a href=\"/locations/qld/cake-makers-ipswich/\">Cake Makers Ipswich</a></li>\n        <li><a href=\"/locations/vic/cake-makers-mornington-peninsula/\">Cake Makers Mornington Peninsula</a></li>\n        <li><a href=\"/locations/vic/cake-makers-werribee/\">Cake Makers Werribee</a></li>\n      </ul>\n    </div>\n  </div>\n</section>\n\n<!-- ================= FOUR STEPS, ONE BRIEF ================= -->\n<section>\n  <div class=\"wrap\">\n    <div class=\"brief\">\n      <div>\n        <div class=\"sec-head\" style=\"margin-bottom:0\">\n          <hr class=\"rule\">\n          <span class=\"eyebrow\">How it works</span>\n          <h2>Four steps, <em>one brief</em></h2>\n          <p class=\"lead\">You describe the celebration once. Cake professionals who suit the job respond with what they would make and what it would cost.</p>\n        </div>\n        <ol class=\"steps\">\n          <li><h3>Tell us what you are celebrating</h3><p>The occasion, the date, the suburb and roughly how many people.</p></li>\n          <li><h3>Describe the cake</h3><p>Servings, tiers, flavours, dietary needs and whether it needs delivery or setup.</p></li>\n          <li><h3>Share the look</h3><p>Style direction, colours, inspiration and the budget band you are working to.</p></li>\n          <li><h3>Compare and choose</h3><p>Relevant cake professionals review the brief and respond. You decide who feels right.</p></li>\n        </ol>\n      </div>\n\n      <div class=\"formwrap\">\n        <h3>Start your cake brief</h3>\n        <p class=\"muted\" style=\"font-size:.94rem;margin:0\">Two minutes now saves a week of messaging later.</p>\n        <form class=\"formcard\" novalidate=\"\">\n          <div class=\"two-up\">\n            <div class=\"field\">\n              <label for=\"f-name\">Your name <span class=\"req\">*</span></label>\n              <input id=\"f-name\" name=\"name\" type=\"text\" autocomplete=\"name\" required=\"\">\n            </div>\n            <div class=\"field\">\n              <label for=\"f-email\">Email <span class=\"req\">*</span></label>\n              <input id=\"f-email\" name=\"email\" type=\"email\" autocomplete=\"email\" required=\"\">\n            </div>\n          </div>\n          <div class=\"two-up\">\n            <div class=\"field\">\n              <label for=\"f-phone\">Phone</label>\n              <input id=\"f-phone\" name=\"phone\" type=\"tel\" autocomplete=\"tel\">\n            </div>\n            <div class=\"field\">\n              <label for=\"f-suburb\">Suburb or postcode</label>\n              <input id=\"f-suburb\" name=\"suburb\" type=\"text\" autocomplete=\"address-level2\">\n            </div>\n          </div>\n          <div class=\"field\">\n            <label for=\"f-service\">What are you celebrating</label>\n            <select id=\"f-service\" name=\"service\">\n              <option value=\"\">Choose a celebration</option>\n              <option>Wedding</option><option>Birthday</option><option>Kids birthday</option>\n              <option>Engagement</option><option>Baby shower</option><option>Christening</option>\n              <option>Anniversary</option><option>Corporate event</option><option>Something else</option>\n            </select>\n          </div>\n          <button class=\"btn btn-1 btn-block\" type=\"submit\">Start my cake brief<svg width=\"15\" height=\"12\" viewBox=\"0 0 15 12\" fill=\"none\" aria-hidden=\"true\"><path d=\"M9 1l5 5-5 5M14 6H1\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></button>\n        </form>\n        <p class=\"muted\" style=\"font-size:.82rem;margin:18px 0 0\">Continue to the full brief to add servings, tiers, style direction, dietary needs and your budget band.</p>\n      </div>\n    </div>\n  </div>\n</section>\n</main>"
      }
    },
